# SMTP email account used to send birthday wishes.
# For Gmail, create an "App Password" (not your normal password) — see
# https://myaccount.google.com/apppasswords
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Input/output file names (optional overrides).
CONTACTS_FILE=contacts.xlsx
REPORT_FILE=birthday_report.xlsx
